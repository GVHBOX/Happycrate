{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "happycrate",
  "version": "1.0.4",
  "identifier": "com.happycrate.app",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Happycrate v1.0.4",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "shadow": false,
        "backgroundColor": [255, 255, 255, 255]
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "主窗口的默认权限",
          "windows": ["main"],
          "permissions": ["core:default", "core:window:allow-start-dragging"]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["assets/icon.ico"]
  }
}
